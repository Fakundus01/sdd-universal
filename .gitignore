# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
.obsidian/

# Herramientas (config local; .claude/launch.json SÍ se versiona)
.claude/settings.local.json
.claude/worktrees/
.vercel/
# Serena: project.yml SÍ se versiona (es config del proyecto); sus memorias las
# genera la herramienta sola en cada máquina, y el .bak lo deja al editar.
.serena/memories/
.serena/*.bak

# Nunca secretos (R17)
.env
.env.*
!.env.example

# Supabase: la clave anon es pública y SÍ se versiona (web/supabase-config.js).
# La service_role nunca entra al repo — si algún día hace falta, va en .env.
.supabase/

# Entorno local (ADR-012): el clúster de Postgres, su log y el secreto de los JWT
dev/.data/

# Cerebro (S41): entorno virtual local y modelos
cerebro/.venv/

# Python: bytecode cacheado, nunca fuente
__pycache__/
*.pyc

# Dependencias de las funciones serverless bajo api/ (IA-1): el SDK de Anthropic
node_modules/
